// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`characterization: OCR cache schema > is one table keyed by (sha256, page, lang, dpi) 1`] = `
[
  {
    "name": "ocr",
    "sql": "CREATE TABLE ocr (
        sha256  TEXT NOT NULL,
        page_no INTEGER NOT NULL,
        lang    TEXT NOT NULL,
        dpi     INTEGER NOT NULL,
        text    TEXT NOT NULL,
        PRIMARY KEY (sha256, page_no, lang, dpi)
      )",
    "type": "table",
  },
]
`;

exports[`characterization: session index schema > creates exactly these tables, indexes and FTS tables 1`] = `
[
  {
    "name": "documents_conversation",
    "sql": "CREATE INDEX documents_conversation ON documents(conversation_id)",
    "type": "index",
  },
  {
    "name": "documents_expires",
    "sql": "CREATE INDEX documents_expires ON documents(expires_at) WHERE expires_at IS NOT NULL",
    "type": "index",
  },
  {
    "name": "documents_sha256",
    "sql": "CREATE INDEX documents_sha256 ON documents(sha256)",
    "type": "index",
  },
  {
    "name": "documents_tender_filename",
    "sql": "CREATE UNIQUE INDEX documents_tender_filename
  ON documents(filename) WHERE conversation_id IS NULL",
    "type": "index",
  },
  {
    "name": "texts_page",
    "sql": "CREATE INDEX texts_page ON texts(page_id)",
    "type": "index",
  },
  {
    "name": "documents",
    "sql": "CREATE TABLE documents (
  id               INTEGER PRIMARY KEY,
  filename         TEXT NOT NULL,
  filename_search  TEXT NOT NULL,
  filename_loose   TEXT NOT NULL,
  sha256           TEXT NOT NULL,
  size_bytes       INTEGER NOT NULL,
  page_count       INTEGER NOT NULL,
  ocr_lang         TEXT NOT NULL,
  settings         TEXT NOT NULL,
  error            TEXT,
  indexed_at       TEXT NOT NULL,
  -- NULL: the standalone tender corpus. Set: one chat conversation's upload.
  conversation_id  TEXT,
  -- Display name for an upload (the tender corpus has none: filename IS it).
  original_filename TEXT,
  uploaded_at      TEXT,
  expires_at       TEXT,
  status           TEXT NOT NULL DEFAULT 'ready' CHECK (status IN ('ready','indexing','failed'))
)",
    "type": "table",
  },
  {
    "name": "meta",
    "sql": "CREATE TABLE meta (
  key   TEXT PRIMARY KEY,
  value TEXT NOT NULL
)",
    "type": "table",
  },
  {
    "name": "pages",
    "sql": "CREATE TABLE pages (
  id              INTEGER PRIMARY KEY,
  doc_id          INTEGER NOT NULL REFERENCES documents(id) ON DELETE CASCADE,
  page_no         INTEGER NOT NULL,
  page_label      TEXT,
  source          TEXT NOT NULL CHECK (source IN ('text','text+ocr','ocr','blank','failed','pending-ocr')),
  ocr_reason      TEXT,
  image_coverage  REAL NOT NULL DEFAULT 0,
  layer_chars     INTEGER NOT NULL DEFAULT 0,
  ocr_chars       INTEGER NOT NULL DEFAULT 0,
  error           TEXT,
  UNIQUE (doc_id, page_no)
)",
    "type": "table",
  },
  {
    "name": "texts",
    "sql": "CREATE TABLE texts (
  id       INTEGER PRIMARY KEY,
  page_id  INTEGER NOT NULL REFERENCES pages(id) ON DELETE CASCADE,
  kind     TEXT NOT NULL CHECK (kind IN ('layer','ocr')),
  body     TEXT NOT NULL,
  search   TEXT NOT NULL,
  loose    TEXT NOT NULL
)",
    "type": "table",
  },
  {
    "name": "texts_exact",
    "sql": "CREATE VIRTUAL TABLE texts_exact USING fts5(
  search, content='', contentless_delete=1, tokenize='trigram case_sensitive 1'
)",
    "type": "table",
  },
  {
    "name": "texts_exact_config",
    "sql": "CREATE TABLE 'texts_exact_config'(k PRIMARY KEY, v) WITHOUT ROWID",
    "type": "table",
  },
  {
    "name": "texts_exact_data",
    "sql": "CREATE TABLE 'texts_exact_data'(id INTEGER PRIMARY KEY, block BLOB)",
    "type": "table",
  },
  {
    "name": "texts_exact_docsize",
    "sql": "CREATE TABLE 'texts_exact_docsize'(id INTEGER PRIMARY KEY, sz BLOB, origin INTEGER)",
    "type": "table",
  },
  {
    "name": "texts_exact_idx",
    "sql": "CREATE TABLE 'texts_exact_idx'(segid, term, pgno, PRIMARY KEY(segid, term)) WITHOUT ROWID",
    "type": "table",
  },
  {
    "name": "texts_loose",
    "sql": "CREATE VIRTUAL TABLE texts_loose USING fts5(
  loose, content='', contentless_delete=1, tokenize='trigram case_sensitive 1'
)",
    "type": "table",
  },
  {
    "name": "texts_loose_config",
    "sql": "CREATE TABLE 'texts_loose_config'(k PRIMARY KEY, v) WITHOUT ROWID",
    "type": "table",
  },
  {
    "name": "texts_loose_data",
    "sql": "CREATE TABLE 'texts_loose_data'(id INTEGER PRIMARY KEY, block BLOB)",
    "type": "table",
  },
  {
    "name": "texts_loose_docsize",
    "sql": "CREATE TABLE 'texts_loose_docsize'(id INTEGER PRIMARY KEY, sz BLOB, origin INTEGER)",
    "type": "table",
  },
  {
    "name": "texts_loose_idx",
    "sql": "CREATE TABLE 'texts_loose_idx'(segid, term, pgno, PRIMARY KEY(segid, term)) WITHOUT ROWID",
    "type": "table",
  },
]
`;
