# Locus settings. Copy to .env.local (or run `npm run setup`, which does it for you) and fill in the values.
# .env.local holds secrets: never share it or commit it (it is git-ignored). Lines starting with # are comments;
# a setting you leave out takes its default.

# ---- Sign-in ---------------------------------------------------------------------------------------------------
# Signs the login cookie. Required for `npm start`. `npm run setup` generates one. By hand: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=<long-random-string>
# Turn on named accounts (admin + the people the admin adds). Needed for the Server, Sources, Users and Activity pages.
LOCUS_USERS_ENABLED=true
# The admin password as a scrypt hash (`npm run setup` writes this; the password itself is never stored).
# LOCUS_ADMIN_PASSCODE_HASH=
# Or the admin password in plain text instead of the hash (simplest for Docker; the hash is safer).
# LOCUS_ADMIN_PASSCODE=
# Who may create an account on the login page: code (needs LOCUS_SIGNUP_CODE), open (anyone), or off (only the admin adds people).
LOCUS_SIGNUP=off
# LOCUS_SIGNUP_CODE=
# Shared passcode of the old one-passcode mode (only used when LOCUS_USERS_ENABLED is not true).
# LOCUS_PASSCODE=

# ---- Storage server (where the PDFs live) ---------------------------------------------------------------------
# folder = a folder on this computer or a network share mounted on it | s3 = MinIO / AWS S3 / R2 | none = not connected
LOCUS_SERVER_TYPE=none
# folder: the full path. macOS /Volumes/tenders, Linux /mnt/nas/tenders, Windows Z:\tenders or \\nas01\share\tenders
# LOCUS_SERVER_PATH=
# s3: the server's address (leave out for AWS S3), e.g. http://minio.company.local:9000
# LOCUS_SERVER_S3_ENDPOINT=
# s3: the region (MinIO accepts the default).
# LOCUS_SERVER_S3_REGION=us-east-1
# s3: the bucket that holds the PDFs.
# LOCUS_SERVER_S3_BUCKET=
# s3: only index this folder of the bucket (leave out for the whole bucket), e.g. tenders/2025
# LOCUS_SERVER_S3_PREFIX=
# s3: a key that can READ the bucket (Locus never writes). Keep these two secret.
# LOCUS_SERVER_S3_ACCESS_KEY=
# LOCUS_SERVER_S3_SECRET_KEY=
# s3: true for MinIO and most self-hosted servers (the default when an endpoint is set), false for AWS S3.
# LOCUS_SERVER_S3_FORCE_PATH_STYLE=true
# How often the server is checked for added, changed and deleted PDFs, in minutes (default 10). "Rescan now" on the Server page does it at once.
LOCUS_SYNC_INTERVAL_MIN=10
# Folder server only: also watch it for changes between those checks (a hint; the timed check always runs). false to turn off.
# LOCUS_SERVER_WATCH=true
# The Server, Sources and My folders features. Must be true to index a storage server.
LOCUS_LIBRARY_ENABLED=true

# ---- Where things are kept and how much room they may use ------------------------------------------------------
# The folder that holds the search index of the storage server. Default: ./data/locus-data in the Locus folder. Point it at a
# disk with room to spare (a real local disk, not a network share).
# LOCUS_DATA_DIR=
# Always leave this much disk free, in GB (default 5 once a server is connected). Indexing pauses and uploads are refused before the disk fills.
LOCUS_MIN_FREE_GB=5
# Upload limit per account, in MB (default 20000 = 20 GB).
LOCUS_USER_UPLOAD_MB=20000
# Total cap on uploads + their index, in bytes. Default: half the disk, at least 5 GB. Set it only to choose a different number.
# STORAGE_CAP_BYTES=
# Files a person uploads (not the storage server): where they and their search index are kept. Defaults are under ./data.
# UPLOADS_DIR=
# SEARCH_INDEX_PATH=
# LOCUS_APP_DIR=

# ---- Reading the PDFs ------------------------------------------------------------------------------------------
# Which pages of the storage server's PDFs get OCR: smart (default with a server: pages with no text, with images, or with
# broken text), auto, or all (slowest, most thorough).
# LIBRARY_OCR_PAGES=smart
# OCR languages (default English + Hindi): the tesseract language codes joined with +.
# LIBRARY_OCR_LANG=eng+hin
# Files read at once, and OCR/PDF tools running at once (default: your CPU cores minus 2).
# LIBRARY_FILES_IN_FLIGHT=4
# LIBRARY_CONCURRENCY=
# Skip PDFs bigger than this, in bytes (default 500 MB).
# LIBRARY_MAX_FILE_BYTES=
# A file changed in the last this-many seconds is left alone until it settles, so a PDF still being copied isn't read half-written (default 120).
# LIBRARY_SETTLE_SECONDS=120

# ---- Chat with a local model (optional, OFF; search never uses a model) ----------------------------------------
LOCUS_CHAT_ENABLED=false
# LM_STUDIO_BASE_URL=http://localhost:1234/v1
# LM_STUDIO_MODEL=qwen/qwen3-4b

# ---- Running it ------------------------------------------------------------------------------------------------
# The port `npm start` listens on (default 3000).
# PORT=3000
# Sharing outside your network with `npm run share` (the optional Cloudflare tunnel + Vercel link): not needed for normal use.
# TUNNEL_TRANSPORT_PROTOCOL=http2
