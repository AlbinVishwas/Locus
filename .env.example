# Copy to .env.local and fill in. Never commit .env.local.
# Placeholders only: replace every <...> with your own value.

# --- Sign-in -----------------------------------------------------------------
# Shared passcode (used when accounts mode is off; also the default sign-up code).
LOCUS_PASSCODE=<choose-a-passcode>
# Signs the login cookie. Required for a production server; `npm run share`
# generates one for you if it is missing. Generate: node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
SESSION_SECRET=<long-random-string>

# --- Accounts mode -----------------------------------------------------------
LOCUS_USERS_ENABLED=true
# The admin account's passcode (the admin area exists only when this is set).
LOCUS_ADMIN_PASSCODE=<choose-an-admin-passcode>
# Who may create an account: code (needs the sign-up code) | open | off
LOCUS_SIGNUP=code
# Optional. Defaults to LOCUS_PASSCODE.
# LOCUS_SIGNUP_CODE=<signup-code>

# --- Upload limits -----------------------------------------------------------
# Upload limit per account, in MB (default 1000).
LOCUS_USER_UPLOAD_MB=1000
# Total cap on uploads + search index for the whole machine, in bytes (default 5000000000 = 5 GB).
STORAGE_CAP_BYTES=5000000000

# --- Library / Sources (optional) --------------------------------------------
LOCUS_LIBRARY_ENABLED=false
# Encrypts saved database passwords for Sources. `npm run share` generates one when needed.
# LOCUS_SECRETS_KEY=<long-random-string>
# Let ordinary accounts add their own folders (private to them).
LOCUS_USER_SOURCES=false
# Also let them add a database as a source (testing switch).
LOCUS_USER_DATABASES=false
# Extra absolute folders the library may read, comma-separated (default /Volumes).
# LOCUS_ALLOWED_ROOTS=</absolute/path/one>,</absolute/path/two>

# --- Chat with a local model (optional, OFF by default) ----------------------
# Search never uses a model. Turn this on only to enable chat replies via LM Studio.
LOCUS_CHAT_ENABLED=false
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_MODEL=qwen/qwen3-4b
